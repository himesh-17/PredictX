# ==============================================================================
# PREDICT X — PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# AIoT-Based Predictive Maintenance & Machine Health Monitoring Platform
# ==============================================================================

# 1. CORE SERVER SETTINGS
NODE_ENV=production
PORT=5000
CORS_ORIGIN=*

# 2. MONGODB ATLAS CLOUD PERSISTENCE
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pgyyqa1.mongodb.net/predict_x?retryWrites=true&w=majority

# 3. PYTHON FASTAPI AI MICROSERVICE (ISOLATION FOREST INFERENCE)
AI_SERVICE_URL=http://127.0.0.1:8000/api/v1
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# 4. TELEMETRY SIMULATION ENGINE
SIMULATION_INTERVAL_MS=1000
SIMULATION_AUTO_START=true

# 5. HARDWARE INTERFACING (ESP32 FIRMWARE INGESTION)
ESP32_TELEMETRY_ENDPOINT=/api/v1/telemetry/hardware

# 6. SYSTEM SECURITY & ADMIN CONTROL PANEL (MANAGE LIMITS AUTHENTICATION)
ADMIN_ID=admin
ADMIN_PASSWORD=predictx2026
