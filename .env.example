# ==============================================================================
# PREDICT X — FULL-STACK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your MongoDB Atlas URL and credentials
# ==============================================================================

# 1. BACKEND SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# 2. MONGODB DATABASE CONFIGURATION
# For local backend development, omit MONGODB_URI to use the default:
# mongodb://127.0.0.1:27017/predict_x
#
# MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/predict_x?retryWrites=true&w=majority
# Docker Compose uses its bundled MongoDB unless MONGODB_URI is set.

# 3. PYTHON FASTAPI AI MICROSERVICE
AI_SERVICE_URL=http://127.0.0.1:8000/api/v1
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# 4. TELEMETRY SIMULATION CONFIGURATION
SIMULATION_INTERVAL_MS=1000
SIMULATION_AUTO_START=true

# 5. HARDWARE INTERFACING (ESP32 FIRMWARE)
ESP32_TELEMETRY_ENDPOINT=/api/v1/telemetry/hardware

# 6. SYSTEM SECURITY & ADMIN CREDENTIALS (MANAGE LIMITS ACCESS)
ADMIN_ID=admin
ADMIN_PASSWORD=predictx2026
